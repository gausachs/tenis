{
  "name": "tenis-fate",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "node scripts/generate-engine.mjs",
    "dev": "npm run generate && vite --host 127.0.0.1",
    "build": "npm run generate && node scripts/build.mjs",
    "db:generate": "drizzle-kit generate",
    "test": "npm run generate && node --test tests/*.test.mjs",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate-postgres.mjs"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.0",
    "drizzle-orm": "^0.44.0",
    "vite": "^8.0.0",
    "@electric-sql/pglite": "^0.3.14"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "pg": "^8.16.3"
  }
}
